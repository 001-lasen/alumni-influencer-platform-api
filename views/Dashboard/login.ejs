<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <title>Login — Alumni Analytics</title>
    <link rel="stylesheet" href="/css/dashboard.css"/>
</head>
<body class="login-page">
<div class="login-card">
    <div class="login-brand">Alumni<span>IQ</span></div>
    <p class="login-subtitle">University Analytics Dashboard</p>

    <div id="alertBox" class="alert-error" style="display:none;"></div>
    <div id="successBox" class="alert-success" style="display:none;"></div>

    <div class="tab-bar">
        <button class="tab-btn active" data-tab="login">Sign In</button>
        <button class="tab-btn" data-tab="register">Register</button>
        <button class="tab-btn" data-tab="forgot">Forgot Password</button>
    </div>

    <div id="tab-login" class="tab-content">
        <div class="form-group">
            <label>Email</label>
            <input type="email" id="loginEmail" placeholder="you@university.ac.lk"/>
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" id="loginPassword" placeholder="••••••••"/>
        </div>
        <button class="btn-primary" id="loginBtn">Sign In</button>
    </div>

    <div id="tab-register" class="tab-content" style="display:none;">

        <div id="reg-step1">
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="regEmail" placeholder="you@university.ac.lk"/>
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" id="regPassword" placeholder="••••••••"/>
            </div>
            <div class="form-group">
                <label>User Type</label>
                <select id="regUserType" class="filter-input" style="width:100%">
                    <option value="ALUMNI">Alumni</option>
                    <option value="DEVELOPER">Developer</option>
                </select>
            </div>
            <button class="btn-primary" id="registerBtn">Create Account</button>
        </div>

        <div id="reg-step2" style="display:none;">
            <p class="login-subtitle" style="margin-bottom:1rem;">Enter the OTP sent to your email</p>
            <div class="form-group">
                <label>OTP</label>
                <input type="text" id="regOtpInput" placeholder="######"/>
            </div>
            <button class="btn-primary" id="verifyRegOtpBtn">Verify Email</button>
            <button class="btn-secondary" id="resendOtpBtn" style="width:100%;margin-top:0.5rem;">Resend OTP</button>
        </div>

    </div>

    <div id="tab-forgot" class="tab-content" style="display:none;">

        <div id="forgot-step1">
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="forgotEmail" placeholder="you@university.ac.lk"/>
            </div>
            <button class="btn-primary" id="sendOtpBtn">Send OTP</button>
        </div>

        <div id="forgot-step2" style="display:none;">
            <p class="login-subtitle" style="margin-bottom:1rem;">Enter the OTP sent to your email</p>
            <div class="form-group">
                <label>OTP</label>
                <input type="text" id="otpInput" placeholder="######"/>
            </div>
            <button class="btn-primary" id="verifyOtpBtn">Verify OTP</button>
        </div>

        <div id="forgot-step3" style="display:none;">
            <p class="login-subtitle" style="margin-bottom:1rem;">Set your new password</p>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" id="newPassword" placeholder="••••••••"/>
            </div>
            <button class="btn-primary" id="resetPasswordBtn">Reset Password</button>
        </div>

    </div>
</div>
<script>

    let forgotEmailValue = null;
    let regEmailValue = null;

    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(t => t.style.display = 'none');
            btn.classList.add('active');
            document.getElementById('tab-' + btn.dataset.tab).style.display = 'block';
            clearAlerts();
        });
    });

    function showError(msg) {
        const el = document.getElementById('alertBox');
        el.textContent = msg;
        el.style.display = 'block';
        document.getElementById('successBox').style.display = 'none';
    }

    function showSuccess(msg) {
        const el = document.getElementById('successBox');
        el.textContent = msg;
        el.style.display = 'block';
        document.getElementById('alertBox').style.display = 'none';
    }

    function clearAlerts() {
        document.getElementById('alertBox').style.display = 'none';
        document.getElementById('successBox').style.display = 'none';
    }

    document.getElementById('loginBtn').addEventListener('click', async () => {
        const email = document.getElementById('loginEmail').value;
        const password = document.getElementById('loginPassword').value;
        try {
            const res = await fetch('/api/users/login', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email, password}),
                credentials: 'include'
            });
            const data = await res.json();
            if (!res.ok) return showError(data.message || 'Login failed');
            localStorage.setItem('accessToken', data.accessToken);
            window.location.href = '/dashboard';
        } catch (err) {
            showError('Network error');
        }
    });

    document.getElementById('registerBtn').addEventListener('click', async () => {
        const email = document.getElementById('regEmail').value;
        const password = document.getElementById('regPassword').value;
        const userType = document.getElementById('regUserType').value;
        regEmailValue = email;
        try {
            const res = await fetch('/api/users/create-user', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email, password, userType})
            });
            const data = await res.json();
            if (!res.ok) return showError(data.message || 'Registration failed');
            showSuccess('Account created! Check your email for the OTP.');
            document.getElementById('reg-step1').style.display = 'none';
            document.getElementById('reg-step2').style.display = 'block';
        } catch (err) {
            showError('Network error');
        }
    });

    document.getElementById('verifyRegOtpBtn').addEventListener('click', async () => {
        const otp = document.getElementById('regOtpInput').value;
        try {
            const res = await fetch('/api/users/verify-email', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email: regEmailValue, otp})
            });
            const data = await res.json();
            if (!res.ok) return showError(data.message || 'Invalid OTP');
            showSuccess('Email verified! You can now sign in.');
            setTimeout(() => {
                document.querySelector('[data-tab="login"]').click();
            }, 2000);
        } catch (err) {
            showError('Network error');
        }
    });

    document.getElementById('resendOtpBtn').addEventListener('click', async () => {
        try {
            const res = await fetch(`/api/users/resend-otp?email=${encodeURIComponent(regEmailValue)}`);
            const data = await res.json();
            if (!res.ok) return showError(data.message || 'Failed to resend OTP');
            showSuccess('OTP resent to your email.');
        } catch (err) {
            showError('Network error');
        }
    });

    document.getElementById('sendOtpBtn').addEventListener('click', async () => {
        forgotEmailValue = document.getElementById('forgotEmail').value;
        try {
            const res = await fetch('/api/users/forgot-password', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email: forgotEmailValue})
            });
            const data = await res.json();
            if (!res.ok) return showError(data.message || 'Failed to send OTP');
            showSuccess('OTP sent to your email.');
            document.getElementById('forgot-step1').style.display = 'none';
            document.getElementById('forgot-step2').style.display = 'block';
        } catch (err) {
            showError('Network error');
        }
    });

    document.getElementById('verifyOtpBtn').addEventListener('click', async () => {
        const otp = document.getElementById('otpInput').value;
        try {
            const res = await fetch('/api/users/verify-forgot-password-otp', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email: forgotEmailValue, otp})
            });
            const data = await res.json();
            if (!res.ok) return showError(data.message || 'Invalid OTP');
            showSuccess('OTP verified! Set your new password.');
            document.getElementById('forgot-step2').style.display = 'none';
            document.getElementById('forgot-step3').style.display = 'block';
        } catch (err) {
            showError('Network error');
        }
    });

    document.getElementById('resetPasswordBtn').addEventListener('click', async () => {
        const newPassword = document.getElementById('newPassword').value;
        try {
            const res = await fetch('/api/users/reset-password', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email: forgotEmailValue, newPassword})
            });
            const data = await res.json();
            if (!res.ok) return showError(data.message || 'Reset failed');
            showSuccess('Password reset! You can now sign in.');
            setTimeout(() => {
                document.querySelector('[data-tab="login"]').click();
            }, 2000);
        } catch (err) {
            showError('Network error');
        }
    });
</script>
</body>
</html>
